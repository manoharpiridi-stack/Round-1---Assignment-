# Copy this file to .env and fill in your own values.

# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

EXTRACTION_MODEL=gemma2-9b-it
RISK_MODEL=llama-3.3-70b-versatile

# Postgres connection string. Swap for MySQL if you prefer, e.g.:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aivoa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivoa

CORS_ORIGINS=http://localhost:5173
